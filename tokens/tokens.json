    "ease": "cubic-bezier(.2,.8,.2,1)"
  },
  "shadow": {
    "shadow": "rgba(29,41,57,.1)",
    "shadow-sm": "0 1px 2px var(--shadow),0 1px 3px var(--shadow)",
    "shadow-md": "0 2px 4px -1px var(--shadow),0 4px 8px -2px var(--shadow)"
